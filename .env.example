# AgentAuth Environment Configuration
# Copy this file to .env and fill in all values before running any service.
# NEVER commit .env to version control.

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL Primary (read-write)
DATABASE_URL=postgres://agentauth:agentauth_dev@localhost:5432/agentauth

# PostgreSQL Replica (read-only, used by verifier)
DATABASE_REPLICA_URL=postgres://agentauth:agentauth_dev@localhost:5433/agentauth

# Database password (used by docker-compose)
POSTGRES_PASSWORD=agentauth_dev

# Connection pool size (recommended: (CPU cores × 2) + disk spindles)
DATABASE_POOL_SIZE=16

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis Cluster nodes (comma-separated)
# For docker-compose, use ports 6399, 6400, 6401 to avoid conflicts with local Redis
REDIS_CLUSTER_NODES=localhost:6399,localhost:6400,localhost:6401

# Redis connection timeout in milliseconds
REDIS_TIMEOUT_MS=2000

# =============================================================================
# KMS Configuration (Production Only)
# =============================================================================

# KMS backend type: aws_kms, gcp_kms, vault_transit, or encrypted_keyfile (dev only)
KMS_BACKEND=encrypted_keyfile

# AWS KMS (if KMS_BACKEND=aws_kms)
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1

# GCP KMS (if KMS_BACKEND=gcp_kms)
GCP_KMS_KEY_RESOURCE_NAME=

# HashiCorp Vault Transit (if KMS_BACKEND=vault_transit)
# For local development with docker-compose, use:
#   VAULT_ADDR=http://localhost:8200
#   VAULT_TOKEN=dev-root-token
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY_NAME=registry-signing-key

# Encrypted Keyfile (Development Only - NEVER use in production)
ENCRYPTED_KEYFILE_PATH=./dev-keys/signing-key.enc
ENCRYPTED_KEYFILE_PASSPHRASE=

# =============================================================================
# Service Configuration
# =============================================================================

# Registry service
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8080
REGISTRY_METRICS_PORT=9091

# Verifier service
VERIFIER_HOST=0.0.0.0
VERIFIER_PORT=8081
VERIFIER_METRICS_PORT=9092

# TLS Configuration (required for all services)
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt

# =============================================================================
# Observability Configuration
# =============================================================================

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentauth
OTEL_TRACE_SAMPLE_RATE=0.01

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Grafana (docker-compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Feature Flags
# =============================================================================

# Enable strict behavioral envelope enforcement
AGENTAUTH_FF_STRICT_ENVELOPE=true

# Require DPoP proof on all token verifications
AGENTAUTH_FF_REQUIRE_DPOP=true

# Enable audit log hash chain
AGENTAUTH_FF_AUDIT_HASH_CHAIN=true

# =============================================================================
# Operational Configuration
# =============================================================================

# Token lifetime in seconds (max 900 = 15 minutes)
TOKEN_LIFETIME_SECS=900

# Grant request expiry in seconds
GRANT_EXPIRY_SECS=3600

# Maximum pending approvals per agent
MAX_PENDING_APPROVALS=5

# Approval cooldown backoff (comma-separated hours)
APPROVAL_COOLDOWN_HOURS=1,4,24

# In-flight request limit for load shedding
MAX_INFLIGHT_REQUESTS=1000

# Audit buffer size (events)
AUDIT_BUFFER_SIZE=10000

# =============================================================================
# Development Only
# =============================================================================

# Allow running without TLS (NEVER enable in production)
# ALLOW_INSECURE_HTTP=false

# SQLx offline mode
SQLX_OFFLINE=false
